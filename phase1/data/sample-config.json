{
  "settings": {
    "showPolarity": false
  },
  "script": {
    "scenes": [
      {
        "id": "s1",
        "isTarget": false,
        "lines": [
          {
            "kind": "direction",
            "n": 1,
            "speaker": "",
            "text": "좁은 부엌. 어머니가 식탁에 수저를 두 벌 놓는다. 수진이 외투를 입은 채 서 있다."
          },
          {
            "kind": "line",
            "n": 2,
            "speaker": "어머니",
            "text": "밥은 먹고 가. 서울까지 멀잖아."
          },
          {
            "kind": "line",
            "n": 3,
            "speaker": "수진",
            "text": "버스 시간 다 됐어요. 다음에 먹을게요."
          },
          {
            "kind": "line",
            "n": 4,
            "speaker": "어머니",
            "text": "너 지난번에도 다음에라고 했어."
          },
          {
            "kind": "direction",
            "n": 5,
            "speaker": "",
            "text": "수진, 대답하지 않고 식탁 위 숟가락 하나를 서랍에 도로 넣는다."
          },
          {
            "kind": "line",
            "n": 6,
            "speaker": "수진",
            "text": "아빠 방은 아직 그대로예요?"
          },
          {
            "kind": "line",
            "n": 7,
            "speaker": "어머니",
            "text": "치울 사람이 있어야 치우지."
          },
          {
            "kind": "line",
            "n": 8,
            "speaker": "수진",
            "text": "제가 올 때 할게요. 진짜로요."
          },
          {
            "kind": "direction",
            "n": 9,
            "speaker": "",
            "text": "수진 퇴장. 어머니는 서랍을 열어 숟가락을 다시 꺼낸다."
          }
        ],
        "title": "1장 · 부엌, 겨울 저녁"
      },
      {
        "id": "s2",
        "isTarget": false,
        "lines": [
          {
            "kind": "direction",
            "n": 1,
            "speaker": "",
            "text": "식탁에 수저가 한 벌. 동생 민호가 휴대폰을 보고 있다."
          },
          {
            "kind": "line",
            "n": 2,
            "speaker": "민호",
            "text": "누나 이번 주에도 못 온대. 회사 일 때문에."
          },
          {
            "kind": "line",
            "n": 3,
            "speaker": "어머니",
            "text": "그래. 바쁘면 그럴 수 있지."
          },
          {
            "kind": "line",
            "n": 4,
            "speaker": "민호",
            "text": "근데 누나 회사 그만둔 지 한 달 됐어. 엄마한테는 말하지 말래서."
          },
          {
            "kind": "direction",
            "n": 5,
            "speaker": "",
            "text": "어머니, 아무 말 없이 아빠 방 쪽을 본다."
          },
          {
            "kind": "line",
            "n": 6,
            "speaker": "어머니",
            "text": "그 방, 이번 주말에 내가 치울란다."
          }
        ],
        "title": "2장 · 같은 부엌, 석 달 뒤"
      },
      {
        "id": "s3",
        "isTarget": true,
        "lines": [
          {
            "kind": "direction",
            "n": 1,
            "speaker": "",
            "text": "아빠 방 문이 열려 있고 상자 몇 개가 쌓여 있다. 현관문 소리. 수진이 가방을 들고 들어온다."
          },
          {
            "kind": "line",
            "n": 2,
            "speaker": "수진",
            "text": "엄마? 문이 열려 있길래."
          },
          {
            "kind": "line",
            "n": 3,
            "speaker": "어머니",
            "text": "왔니. 연락도 없이."
          },
          {
            "kind": "line",
            "n": 4,
            "speaker": "수진",
            "text": "그냥, 지나가는 길이었어요."
          },
          {
            "kind": "direction",
            "n": 5,
            "speaker": "",
            "text": "수진, 상자들을 본다. 가방을 내려놓지 않는다."
          },
          {
            "kind": "line",
            "n": 6,
            "speaker": "수진",
            "text": "아빠 방 치우는 거예요? 제가 한다고 했잖아요."
          },
          {
            "kind": "line",
            "n": 7,
            "speaker": "어머니",
            "text": "네가 언제 올지 알아야 기다리지."
          },
          {
            "kind": "line",
            "n": 8,
            "speaker": "수진",
            "text": "이번엔 진짜 오려고 했어요. 일이 좀 생겨서."
          },
          {
            "kind": "line",
            "n": 9,
            "speaker": "어머니",
            "text": "무슨 일?"
          },
          {
            "kind": "direction",
            "n": 10,
            "speaker": "",
            "text": "긴 사이. 수진이 가방을 바닥에 내려놓는다."
          },
          {
            "kind": "line",
            "n": 11,
            "speaker": "수진",
            "text": "밥 있어요? 배고파요."
          },
          {
            "kind": "line",
            "n": 12,
            "speaker": "어머니",
            "text": "앉아. 수저 꺼내고."
          },
          {
            "kind": "direction",
            "n": 13,
            "speaker": "",
            "text": "수진, 서랍을 열어 숟가락 두 개를 꺼낸다."
          }
        ],
        "title": "3장 · 같은 부엌, 일요일 아침"
      }
    ],
    "targetCharacter": "수진",
    "title": "[샘플] 빈 방"
  },
  "practice": {
    "scenes": [
      {
        "id": "p1",
        "isTarget": true,
        "lines": [
          {
            "kind": "direction",
            "n": 1,
            "speaker": "",
            "text": "비 오는 정류장. 지우가 우산 없이 서 있다."
          },
          {
            "kind": "line",
            "n": 2,
            "speaker": "태오",
            "text": "같이 쓸래요? 방향 같으면."
          },
          {
            "kind": "line",
            "n": 3,
            "speaker": "지우",
            "text": "괜찮아요. 금방 와요, 버스."
          },
          {
            "kind": "line",
            "n": 4,
            "speaker": "태오",
            "text": "그 버스 아까 지나갔는데요."
          },
          {
            "kind": "direction",
            "n": 5,
            "speaker": "",
            "text": "지우, 잠시 웃는다. 우산 안으로 한 걸음 들어간다."
          },
          {
            "kind": "line",
            "n": 6,
            "speaker": "지우",
            "text": "그럼 다음 거 올 때까지만요."
          }
        ],
        "title": "연습 · 버스 정류장"
      }
    ],
    "targetCharacter": "지우",
    "title": "[샘플] 연습 장면"
  }
}